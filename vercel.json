{
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/tool/notes", "destination": "/notes.html" },
    { "source": "/archive", "destination": "/archive.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/project/:id", "destination": "/project.html?id=:id" },
    { "source": "/scrolled/privacy", "destination": "/scrolled-privacy.html" },
    { "source": "/scrolled/terms", "destination": "/scrolled-terms.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": false },
    { "source": "/notes.html", "destination": "/tool/notes", "permanent": true },
    { "source": "/archive.html", "destination": "/archive", "permanent": false },
    { "source": "/login.html", "destination": "/login", "permanent": false },
    { "source": "/scrolled-privacy.html", "destination": "/scrolled/privacy", "permanent": false },
    { "source": "/scrolled-terms.html", "destination": "/scrolled/terms", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(tool/.*|notes\\.html|notes-app\\.js|archive|archive\\.html|login|login\\.html|api/.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
